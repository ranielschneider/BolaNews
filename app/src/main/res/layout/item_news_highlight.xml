<?xml version="1.0" encoding="utf-8"?>
<!-- ViewHolder tipo 1: Card de destaque (o maior, aparece primeiro na lista) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagem da notícia -->
        <ImageView
            android:id="@+id/ivHighlightImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@color/image_placeholder"
            android:contentDescription="Imagem da notícia" />

        <!-- Conteúdo de texto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Badge de categoria -->
            <TextView
                android:id="@+id/tvHighlightCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="DESTAQUE"
                android:textSize="10sp"
                android:textColor="@color/green_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05" />

            <!-- Título principal -->
            <TextView
                android:id="@+id/tvHighlightTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Título da notícia em destaque"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Fonte e tempo -->
            <TextView
                android:id="@+id/tvHighlightMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GloboEsporte · 1h atrás"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>